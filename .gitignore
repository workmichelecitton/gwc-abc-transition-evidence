# Never commit raw source material. Transcripts and restricted documents
# stay outside this repository — git history is permanent and public.
/transcripts/
/raw/
*.docx
*.vtt
*.srt
*.m4a
*.mp3

# Local noise
.Rhistory
.DS_Store
Thumbs.db
desktop.ini
__pycache__/
*.pyc
.venv/

# Downloaded source documents. These are other organisations' publications,
# they are large, and they are already public at the URL each source row
# carries. The URL is what has to be permanent; the file is a working copy.
sources/pdf/*
!sources/pdf/README.md

# The approved ReliefWeb appname. An identifier rather than a credential, but
# this repo is public and there is no reason to publish it — if someone else
# used it heavily, it is this project's name that gets throttled.
tools/reliefweb-mcp/appname.txt

# Local test dependency (jsdom, for scripts/check.mjs). Installed on demand,
# never committed — it is thousands of files that have nothing to do with the
# evidence base.
node_modules/
package.json
package-lock.json

# Files retired on 16/09/2026 and moved here rather than deleted (this session
# could not delete). git already sees them as removed from their old paths, so
# committing the deletions cleans the repository; the folder is a local holding
# pen and can be deleted in Explorer at any time.
/_to_delete/
